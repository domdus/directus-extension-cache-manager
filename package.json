{
	"name": "directus-extension-cache-manager",
	"description": "Granular cache for Directus: a change clears only the cached responses that use its collection. Rules per collection, Skip Fields, statistics, change analysis, and cache settings without a restart.",
	"icon": "cached",
	"version": "1.1.0",
	"license": "MIT",
	"keywords": [
		"directus",
		"directus-extension",
		"directus-extension-bundle",
		"cache",
		"cache-manager",
		"cache-purge",
		"auto-purge",
		"granular-cache",
		"cache-invalidation",
		"cache-ttl",
		"ttl",
		"purge",
		"performance",
		"module"
	],
	"type": "module",
	"files": [
		"dist",
		"LICENSE",
		"README.md"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/domdus/directus-extension-cache-manager.git"
	},
	"bugs": {
		"url": "https://github.com/domdus/directus-extension-cache-manager/issues"
	},
	"homepage": "https://github.com/domdus/directus-extension-cache-manager#readme",
	"directus:extension": {
		"type": "bundle",
		"path": {
			"app": "dist/app.js",
			"api": "dist/api.js"
		},
		"entries": [
			{
				"type": "module",
				"name": "cache-manager-module",
				"source": "src/module/index.ts"
			},
			{
				"type": "endpoint",
				"name": "cache-manager-endpoint",
				"source": "src/endpoint/index.ts"
			},
			{
				"type": "hook",
				"name": "cache-manager-hook",
				"source": "src/hook/index.ts"
			}
		],
		"host": ">=9.26.0 <13.0.0"
	},
	"scripts": {
		"build": "directus-extension build",
		"dev": "directus-extension build -w --no-minify",
		"link": "directus-extension link",
		"add": "directus-extension add",
		"test": "tsx --test \"src/**/*.test.ts\"",
		"typecheck": "tsc --noEmit -p ."
	},
	"devDependencies": {
		"@directus/extensions-sdk": "^18.1.1",
		"@types/express": "^4.17.25",
		"@types/node": "^22.10.0",
		"graphql": "^16.9.0",
		"tsx": "^4.23.15",
		"typescript": "^5.9.3",
		"vue": "^3.5.43"
	}
}
